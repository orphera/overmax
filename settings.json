{
  "language": "auto",
  "window_tracker": {
    "window_title": "DJMAX RESPECT V",
    "poll_interval_sec": 0.5
  },
  "screen_capture": {
    "logo_ocr_cooldown_sec": 1.0,
    "idle_sleep_sec": 0.5,
    "engine": "auto",
    "content_protected": true,
    "enable_gpu_atlas": true,
    "hdr_sdr_white_level": null
  },
  "debug_window": {
    "max_lines": 500,
    "title": "Overmax Debug Log"
  },
  "overlay": {
    "base_opacity": 0.8,
    "scale": 1.0,
    "lite_mode": false,
    "always_visible": false,
    "position": {
      "snap": "manual"
    }
  },
  "jacket_matcher": {
    "db_path": "cache/image_index.db",
    "similarity_threshold": 0.65,
    "disable_hog": false,
    "margin_threshold": 3.0
  },
  "app_update": {
    "enabled": true,
    "owner": "orphera",
    "repo": "overmax",
    "asset_name": "overmax.zip",
    "linux_asset_name": "overmax-linux-x86_64.tar.gz",
    "latest_release_url": ""
  },
  "varchive": {
    "songs_api_url": "https://v-archive.net/db/v2/songs.json",
    "songs_cache_path": "cache/songs.json",
    "dlcs_api_url": "https://v-archive.net/db/dlcs.json",
    "dlcs_cache_path": "cache/dlcs.json",
    "cache_path": "cache/songs.json",
    "cache_ttl_sec": 86400,
    "download_timeout_sec": 10
  },
  "recommend_provider": {
    "enabled": false,
    "url": null,
    "name": null
  },
  "recommend": {
    "smart_recommend": true,
    "target_rate": 99.0
  },
  "ipc": {
    "enabled": false,
    "port": 30110
  }
}
